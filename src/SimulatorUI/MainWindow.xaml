<Window x:Class="SimulatorUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimulatorUI"
        mc:Ignorable="d"
        Title="Simulator UI" Height="720" Width="1100"
        MinHeight="650" MinWidth="950">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="12"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Nastavení simulace"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Noise"/>
                    <Slider x:Name="NoiseSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="30"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"/>
                    <TextBlock Text="{Binding ElementName=NoiseSlider, Path=Value, StringFormat=F0}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Radius vzorku"/>
                    <Slider x:Name="SampleRadiusSlider"
                            Minimum="1"
                            Maximum="150"
                            Value="50"
                            TickFrequency="1"
                            IsSnapToTickEnabled="False"/>
                    <TextBlock Text="{Binding ElementName=SampleRadiusSlider, Path=Value, StringFormat=F0}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Max radius referenčního bodu"/>
                    <Slider x:Name="RefRadiusSlider"
                            Minimum="2"
                            Maximum="150"
                            Value="20"
                            TickFrequency="1"
                            IsSnapToTickEnabled="False"/>
                    <TextBlock Text="{Binding ElementName=RefRadiusSlider, Path=Value, StringFormat=F0}"
                               Margin="0,0,0,12"/>

                    <Separator Margin="0,8,0,8"/>

                    <TextBlock Text="Vnější obrázek - šířka"/>
                    <TextBox x:Name="OuterWidthTextBox"
                             Text="1480"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Vnější obrázek - výška"/>
                    <TextBox x:Name="OuterHeightTextBox"
                             Text="1224"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Vnitřní obrázek - šířka"/>
                    <TextBox x:Name="InnerWidthTextBox"
                             Text="1280"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Vnitřní obrázek - výška"/>
                    <TextBox x:Name="InnerHeightTextBox"
                             Text="1024"
                             Margin="0,4,0,12"/>

                    <Separator Margin="0,8,0,8"/>

                    <TextBlock Text="Počet simulací"/>
                    <TextBox x:Name="SimulationCountTextBox"
                             Text="1"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Seed"/>
                    <TextBox x:Name="SeedTextBox"
                             Text="12345"
                             Margin="0,4,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="GeneratePreviewButton"
                                Content="Generovat náhled"
                                Width="140"
                                Height="32"
                                Click="GeneratePreview_Click"/>

                        <Button x:Name="RunAlgorithmButton"
                                Content="Spustit algoritmus"
                                Width="140"
                                Height="32"
                                Margin="12,0,0,0"
                                Click="RunAlgorithm_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="8"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6">
                <Viewbox Stretch="Uniform">
                    <Image x:Name="PreviewImage"/>
                </Viewbox>
            </Border>

            <Border Grid.Row="2"
                    Padding="10"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBox x:Name="ResultTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="14"/>
            </Border>
        </Grid>
    </Grid>
</Window>